%% Example # 6.10: Symbolic propagation over a ring of functions

clear; clc;

%% Exact symbolic output
sympref('FloatingPointOutput', false);

%% Symbols
syms s x t
I = sym('1i');

%% Coefficient functions in S = Maps([0,1], C)
one  = sym(1);
eta  = s;
zeta = sin(s);

%% Parameters
M2 = 2;
Nt = 2;
Mx = M2 + 2*Nt;   % maximum spatial degree up to temporal layer Nt

%% Initial coefficients for psi_0(x)=1+s*x+sin(s)*x^2
a = sym(zeros(Nt+1, Mx+1));

a(1,1) = one;    % a_{0,0}
a(1,2) = eta;    % a_{0,1}
a(1,3) = zeta;   % a_{0,2}

%% Initial datum
psi0 = sym(0);
for m = 0:Mx
    psi0 = psi0 + a(1,m+1)*x^m;
end
psi0 = expand(psi0);

disp('Initial datum psi_0(s;x) =')
disp(psi0)

disp('Nonzero initial coefficients:')
for m = 0:Mx
    if ~isequal(simplify(a(1,m+1)), sym(0))
        fprintf('a_{0,%d} = ', m);
        disp(a(1,m+1))
    end
end

%% Symbolic propagation

for m1 = 1:Nt
    for m2 = 0:(M2 + 2*m1)

        L1 = sym(0);
        L2 = sym(0);

        if m2 >= 2
            L1 = a(m1, m2-1);   % corresponds to a_{m1-1,m2-2}
        end

        if m2+2 <= M2 + 2*(m1-1)
            L2 = a(m1, m2+3);   % corresponds to a_{m1-1,m2+2}
        end

        a(m1+1, m2+1) = simplify((-I*L1 + I*sym(m2+2)*sym(m2+1)*L2)/sym(m1));
    end
end

disp(' ')
disp('Nonzero propagated coefficients:')
for m1 = 1:Nt
    for m2 = 0:Mx
        if ~isequal(simplify(a(m1+1,m2+1)), sym(0))
            fprintf('a_{%d,%d} = ', m1, m2);
            disp(a(m1+1,m2+1))
        end
    end
end

%% Build truncated symbolic solution psi^[Nt](s;x,t)
psi = sym(0);
for m1 = 0:Nt
    for m2 = 0:Mx
        psi = psi + a(m1+1,m2+1)*t^m1*x^m2;
    end
end
psi = expand(psi);

disp(' ')
disp('Truncated symbolic solution psi^[2](s;x,t) =')
disp(psi)

